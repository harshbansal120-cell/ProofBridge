# ProofBridge Environment Configuration
# Copy this file to .env and fill in values

# AI Pipeline Mode (demo, gemini, open_source, ensemble)
AI_MODE=demo

# OpenRouter Configuration
OPENROUTER_MODEL=openai/gpt-5.4
OPENROUTER_API_KEY=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18080

# Frontend
VITE_API_URL=http://localhost:18080
FRONTEND_URL=http://localhost:5173

# Demo Mode Configuration
DEMO_MODE=false

# ---------------------------------------------------------
# Optional / Advanced Configuration
# ---------------------------------------------------------

# Gemini Configuration (if AI_MODE=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Open Source / Ollama Configuration (if AI_MODE=open_source)
OLLAMA_BASE_URL=http://localhost:11434
PROOFBRIDGE_MODEL_REGTECH=a-ivanovitch/RegTech-7B-Instruct
PROOFBRIDGE_MODEL_FALLBACK=qwen:0.5b

# Experimental Integrations
ENABLE_OUTLINES=false
ENABLE_DOCLING=false

# Paths & Executables
# DATABASE_URL=sqlite+aiosqlite:///proofbridge.db
NODE_EXECUTABLE=node
